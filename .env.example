# Vialink frontend — env vars
# Copia a .env.local (dev) o configura en Vercel (prod).

# Backend HTTP API. Endpoints REST se sirven en {VITE_API_URL}/api/v1.
# Produccion (Railway, ya desplegado por David):
VITE_API_URL=https://vialink-backend-production.up.railway.app
# Local contra David: http://localhost:3000

# WebSocket. Socket.io se conecta a {VITE_WS_URL}/realtime.
# Suele coincidir con VITE_API_URL.
VITE_WS_URL=https://vialink-backend-production.up.railway.app

# Switch entre datos mock locales y backend real.
# true  -> mocks (default, funciona offline)
# false -> llama al backend Railway con Claude Haiku real, ~18 buses, 500 agentes
VITE_USE_MOCKS=false

# Google Maps Platform — JavaScript API key.
# Para que <MapView/> renderice tiles de Google. Si esta vacia, el mapa
# cae al tile provider previo (CartoDB Voyager).
# IMPORTANTE: restringir el key en Google Cloud Console
#   - HTTP referrers: localhost:5173, *.vercel.app, dominio prod
#   - APIs habilitadas: Maps JavaScript API, Places API (opcional)
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_JS_API_KEY

# Para configurar en Vercel:
# Settings -> Environment Variables -> agrega las 4 anteriores para Production.
# Despues "Redeploy" en el ultimo deployment.
