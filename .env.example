# Vialink frontend — env vars
# Copia a .env.local y ajusta segun tu entorno

# Backend HTTP API. Endpoints REST se sirven en {VITE_API_URL}/api/v1.
# Desarrollo local contra backend David: http://localhost:3000
# Produccion: la URL publica de Railway que pase David.
VITE_API_URL=http://localhost:3000

# WebSocket. Socket.io se conecta a {VITE_WS_URL}/realtime.
# Suele coincidir con VITE_API_URL en dev y prod.
VITE_WS_URL=http://localhost:3000

# Switch entre datos mock locales y backend real.
# true  -> mocks (default, funciona sin backend)
# false -> llama al backend de David
VITE_USE_MOCKS=true
